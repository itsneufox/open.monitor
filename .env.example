# Discord Bot Configuration
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here

# Database Configuration
DATABASE_URL=mysql://username:password@localhost:3306/sampbot

# Owner configuration
OWNER_ID=your_discord_user_id_here
OWNER_GUILD_ID=your_discord_guild_id_here

# Webhook Logging (optional)
# Create a webhook in a Discord channel to receive bot logs
# Leave empty to disable webhook logging
WEBHOOK_LOG_URL=

# Server query error logging (optional; both values are required to enable)
SECURITY_LOG_GUILD_ID=your_discord_guild_id
SECURITY_LOG_CHANNEL_ID=your_discord_channel_id

# Cloudflare R2 backups (enable with: docker compose --profile backup up -d)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=openmonitor
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
BACKUP_PREFIX=mysql/production
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
# COMPOSE_PROFILES=backup
